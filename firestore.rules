rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // 본인 문서만. premium 은 RevenueCat 웹훅(Cloud Function)만 쓴다.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && !request.resource.data.keys().hasAny(['premium']);
      allow update: if isOwner(uid) && !changedKeys().hasAny(['premium']);
      allow delete: if isOwner(uid);

      // 하루 질문 사용량. count 는 1부터 시작해 1씩만 늘릴 수 있다. (무료 한도는 앱에서, 프리미엄은 무제한)
      match /usage/{day} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.count == 1
          && request.resource.data.keys().hasOnly(['count', 'updatedAt']);
        allow update: if isOwner(uid)
          && request.resource.data.count == resource.data.count + 1
          && request.resource.data.keys().hasOnly(['count', 'updatedAt']);
        allow delete: if false;
      }

      // FCM 토큰: 본인 기기만 쓰고, 읽기는 Cloud Functions(관리자)만.
      match /fcmTokens/{deviceId} {
        allow read: if false;
        allow write: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
          && request.resource.data.token is string;
        allow delete: if isOwner(uid);
      }

      match /{col}/{rest=**} {
        allow read, write: if isOwner(uid) && col != 'fcmTokens';
      }
    }

    // 가족 공유 집. 읽기는 멤버만. 멤버십 변경(참여·나가기·내보내기·위임)은 Cloud Function(관리자 권한)만 한다.
    // premiumUntil 은 RevenueCat 웹훅(Function)만 쓴다.
    match /households/{hid} {
      function isMember() { return signedIn() && request.auth.uid in resource.data.memberUids; }
      function isHouseholdOwner() { return isMember() && resource.data.ownerUid == request.auth.uid; }
      function membershipUntouched() { return !changedKeys().hasAny(['ownerUid', 'memberUids', 'members', 'premiumUntil', 'premiumProductId', 'premiumUpdatedAt', 'createdAt']); }

      allow read: if isMember();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.members.size() == 1
        && request.resource.data.members[0].uid == request.auth.uid
        && request.resource.data.premiumUntil == null
        && request.resource.data.inviteCode is string && request.resource.data.inviteCode.size() == 6;
      // 멤버: 수거일만. 방장: 수거일 + 이름 + 초대 코드 재발급.
      allow update: if membershipUntouched()
        && ((isMember() && changedKeys().hasOnly(['schedule', 'scheduleUpdatedAt']))
            || (isHouseholdOwner() && changedKeys().hasOnly(['schedule', 'scheduleUpdatedAt', 'name', 'inviteCode', 'inviteCodeExpiresAt'])));
      allow delete: if false;

      function memberOf(hid) { return signedIn() && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.memberUids; }

      // 오늘 누가 버렸는지. 멤버 누구나 쓰되 자기 uid 로만.
      match /checkins/{day} {
        allow read: if memberOf(hid);
        allow write: if memberOf(hid);
      }

      // 집 공유 일정 (캘린더). 멤버 누구나 읽고 쓴다.
      match /events/{eventId} {
        allow read, write: if memberOf(hid);
      }
    }

    // "결과가 틀렸나요?" 피드백. 본인 uid 로 만들기만, 읽기·수정은 콘솔에서만.
    match /feedback/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'type', 'imageHash', 'itemName', 'aiResult', 'userAnswer', 'memo', 'createdAt', 'regionCode', 'tipId'])
        && request.resource.data.type in ['classification', 'region']
        && request.resource.data.userAnswer in ['recycle', 'general', 'food', 'special', 'region_note_wrong']
        && request.resource.data.memo is string && request.resource.data.memo.size() <= 200;
      allow read, update, delete: if false;
    }

    // 지역 노트 신고 카운터. 한 사용자가 한 번만 올릴 수 있고(count == reporters 수), 3건이면 앱이 노트를 숨긴다.
    match /regionNoteReports/{key} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['count', 'reporters', 'updatedAt'])
        && request.resource.data.reporters == [request.auth.uid]
        && request.resource.data.count == 1;
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['count', 'reporters', 'updatedAt'])
        && !(request.auth.uid in resource.data.reporters)
        && request.resource.data.reporters.hasAll(resource.data.reporters)
        && request.resource.data.reporters.size() == resource.data.reporters.size() + 1
        && request.auth.uid in request.resource.data.reporters
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
